.env
# Lokales Entwicklungs-Environment (uv) - im Image baut uv sync ein eigenes
.venv/
# Laufzeitdaten nie ins Image - nur die Fallback-CSV wird gebraucht
data/*
!data/dax_mdax_fallback.csv
pgdata/
backups/
logs/
# Lokaler Stack (U1): Datenbank, Logs, npm-Cache - nie in den Build-Kontext
.local/
# Frontend (P3.5) hat ein eigenes Image mit eigenem Kontext (P3.6)
frontend/
**/__pycache__/
**/*.pyc
.git/
.gitignore
.claude/
README.md
*.md

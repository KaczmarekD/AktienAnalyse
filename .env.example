# === SMTP (Gmail) ===
# Gmail erfordert ein App-Passwort, kein normales Login-Passwort.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deinkonto@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_USE_TLS=true

# === Mail ===
MAIL_FROM=deinkonto@gmail.com
MAIL_TO=empfaenger@example.com
MAIL_SUBJECT_PREFIX=[Value-Screening DAX/MDAX]

# === Universum & Reporting ===
UNIVERSE=DAX_MDAX
TOP_N=20
BOTTOM_N=10
MIN_MARKET_CAP=300000000

# === Scoring (optional, Defaults sind sinnvoll) ===
VALUE_WEIGHT=0.6
QUALITY_WEIGHT=0.4
DEFAULT_TAX_RATE=0.27

# === Operatives ===
# Cron-Schedule (Container-intern, m h dom mon dow). Default = Sa 07:30.
CRON_SCHEDULE=30 7 * * 6

# === Datenbank (PostgreSQL 18, Container "db") ===
# Passwoerter nur aus Buchstaben/Ziffern waehlen - sie landen in Verbindungs-URLs.
# VA_APP_PASSWORD/VA_READ_PASSWORD wirken nur beim allerersten DB-Start (leeres pgdata/).
POSTGRES_PASSWORD=bitte-aendern-owner
VA_APP_PASSWORD=bitte-aendern-app
VA_READ_PASSWORD=bitte-aendern-read
# LAN-Zugriff fuer Auswertungen (DBeaver/Jupyter, Rolle va_read): NAS-IP eintragen.
# Default 127.0.0.1 = nur auf der NAS selbst erreichbar. DSM-Firewall auf das LAN beschraenken.
# DB_LAN_BIND=192.168.1.10
# docker compose setzt DATABASE_URL/DATABASE_OWNER_URL selbst. Nur fuer lokale Entwicklung:
# DATABASE_URL=postgresql+psycopg://va_app:bitte-aendern-app@localhost:5432/value_analyzer

# Optional: Healthchecks.io Endpoint fuer Dead-Man's-Switch
# (Account anlegen, Check erstellen, URL kopieren)
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

TZ=Europe/Berlin

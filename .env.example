# === SMTP (Gmail) ===
# Gmail erfordert ein App-Passwort, kein normales Login-Passwort.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deinkonto@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_USE_TLS=true

# === Mail ===
MAIL_FROM=deinkonto@gmail.com
MAIL_TO=empfaenger@example.com
MAIL_SUBJECT_PREFIX=[Value-Screening DAX/MDAX]

# === Universum & Reporting ===
UNIVERSE=DAX_MDAX
TOP_N=20
BOTTOM_N=10

# === Scoring ===
# Nur Startwerte: Der erste Lauf legt damit das Scoring-Profil "Standard" v1 in der Datenbank an
# (ADR-0009). Danach gilt das aktive Profil, eine Aenderung hier wirkt nicht mehr. Gewichte
# aendern: neue Profil-Version (ab P3.3 im UI).
MIN_MARKET_CAP=300000000
VALUE_WEIGHT=0.6
QUALITY_WEIGHT=0.4
DEFAULT_TAX_RATE=0.27

# === Operatives ===
# Cron-Schedule (Container-intern, m h dom mon dow). Default = Sa 07:30.
CRON_SCHEDULE=30 7 * * 6

# === Datenbank (PostgreSQL 18, Container "db") ===
# Passwoerter nur aus Buchstaben/Ziffern waehlen - sie landen in Verbindungs-URLs.
# VA_APP_PASSWORD/VA_READ_PASSWORD wirken nur beim allerersten DB-Start (leeres pgdata/).
POSTGRES_PASSWORD=bitte-aendern-owner
VA_APP_PASSWORD=bitte-aendern-app
VA_READ_PASSWORD=bitte-aendern-read
# Profile im UI speichern (P3.3): Rolle va_profiles, darf nur in die Profil-Tabellen anfuegen.
# Fehlt sie in einer bestehenden Datenbank, legt der Start des Batches sie mit diesem Passwort an.
VA_PROFILES_PASSWORD=bitte-aendern-profiles
# Seit P5.4 Pflicht (NATS ist Standard): Rolle va_web fuer Projektionen und Runs des web-api,
# je Service eine Rolle nur fuers eigene Schema (P5.3). Der Dienst migrate legt fehlende an.
VA_WEB_PASSWORD=bitte-aendern-web
VA_MARKET_DATA_PASSWORD=bitte-aendern-market-data
VA_SCORING_PASSWORD=bitte-aendern-scoring
VA_NOTIFICATION_PASSWORD=bitte-aendern-notification
# LAN-Zugriff fuer Auswertungen (DBeaver/Jupyter, Rolle va_read): NAS-IP eintragen.
# Default 127.0.0.1 = nur auf der NAS selbst erreichbar. DSM-Firewall auf das LAN beschraenken.
# DB_LAN_BIND=192.168.1.10

# === Web-UI (frontend, P3.6) ===
# Im LAN erreichbar: NAS-IP eintragen, dann http://<nas-ip>:8080. Default 127.0.0.1 = nur auf
# der NAS selbst. DSM-Firewall: Port 8080 nur fuer das eigene Subnetz freigeben.
# UI_LAN_BIND=192.168.1.10
# Hostnamen, unter denen du das UI im Browser aufrufst (Leerzeichen getrennt). Alle anderen
# bekommen keine Antwort (Schutz vor DNS-Rebinding).
# UI_SERVER_NAMES=nas nas.fritz.box 192.168.1.10
# docker compose setzt DATABASE_URL/DATABASE_OWNER_URL selbst. Nur fuer lokale Entwicklung:
# DATABASE_URL=postgresql+psycopg://va_app:bitte-aendern-app@localhost:5432/value_analyzer

# Optional: Healthchecks.io Endpoint fuer Dead-Man's-Switch
# (Account anlegen, Check erstellen, URL kopieren)
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# === Event-Bus (P4.3) ===
# Standard ist der Bus im Prozess. Ueber NATS: EVENT_BUS=nats mit NATS_URL=nats://nats:4222.
# Seit P4.3b verarbeitet jeder Service ein Event nur einmal.
# EVENT_BUS=in_process
# RUN_TIMEOUT_MINUTES=120
# Seit P5.4 fuehren die Dienste market-data, scoring und notification jeden Lauf aus, ueber
# NATS. Den Wochenlauf plant das web-api nach CRON_SCHEDULE (Europe/Berlin), einen Cron im
# Container gibt es nicht mehr. EVENT_BUS gilt nur noch fuer einen Lauf im Prozess
# (make docker-run).

# === Image (aus der CI, GHCR) ===
# VERSION: latest folgt main; sha-<commit> oder eine Version (z. B. 0.3.0) pinnt.
# REG=ghcr.io/kaczmarekd
# VERSION=latest

TZ=Europe/Berlin

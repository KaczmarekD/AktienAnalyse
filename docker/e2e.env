# E2E-Stack (U5.2, docs/architecture/umgebungen.md): make local-e2e und die CI.
# Ersetzt die .env des Rechners (docker compose --env-file). Die Datenbank liegt auf tmpfs, hat
# keinen Port und verschwindet mit dem Stack; die Passwoerter gelten nur dort.
POSTGRES_PASSWORD=e2eowner
VA_APP_PASSWORD=e2eapp
VA_READ_PASSWORD=e2eread

# Replay-Fixture unter tests/fixtures/replay/, mit der der Batch laeuft
E2E_FIXTURE=2026-10-30_scoring-run-1.json

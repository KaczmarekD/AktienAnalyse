{
  "$defs": {
    "FundamentalsV1": {
      "description": "Ein Titel. Fehlende Werte sind ``None``; Fehler des Abrufs stehen in ``errors``.",
      "properties": {
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "growth": {
          "$ref": "#/$defs/GrowthV1",
          "default": {
            "eps_growth_5y": null,
            "revenue_growth_5y": null
          }
        },
        "identity": {
          "$ref": "#/$defs/IdentityV1"
        },
        "market": {
          "$ref": "#/$defs/MarketDataV1",
          "default": {
            "enterprise_value": null,
            "market_cap": null,
            "price": null,
            "shares_outstanding": null
          }
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceV1",
          "default": {
            "fetched_at": null,
            "fiscal_period_end": null,
            "statement_fx": null
          }
        },
        "quality": {
          "$ref": "#/$defs/QualityMetricsV1",
          "default": {
            "debt_to_equity": null,
            "earnings_stability": null,
            "fcf_margin": null,
            "gross_margin": null,
            "net_debt_ebitda": null,
            "operating_margin": null,
            "roa": null,
            "roic": null
          }
        },
        "value": {
          "$ref": "#/$defs/ValueMetricsV1",
          "default": {
            "buyback_yield": null,
            "dividend_yield": null,
            "ev_ebit": null,
            "p_fcf": null,
            "pb_ratio": null,
            "pe_ratio": null,
            "shareholder_yield": null
          }
        }
      },
      "required": [
        "identity"
      ],
      "title": "FundamentalsV1",
      "type": "object"
    },
    "GrowthV1": {
      "properties": {
        "eps_growth_5y": {

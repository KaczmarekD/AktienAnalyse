    "RankingRowV1": {
      "description": "Fundamentaldaten plus Bewertung. notification rendert Mail und CSV allein daraus.\n\nValue- und Quality-Score sind Perzentilraenge zwischen 0 und 1, ``None`` ohne genug\nFaktoren. Der Composite-Score ist ihr gewichtetes Mittel. Er hat bewusst keine\nObergrenze: Die Gewichte werden erst ab 1 % Abweichung normiert, ein Wert knapp\nueber 1 darf den Lauf nicht kippen. ``factor_ranks`` haelt die Raenge je Faktor,\nSchluessel wie im Scoring-Profil (z. B. ``ev_ebit``, ``roic``).",
      "properties": {
        "composite_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Score"
        },
        "factor_ranks": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Factor Ranks",
          "type": "object"
        },
        "fundamentals": {
          "$ref": "#/$defs/FundamentalsV1"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "rank_overall": {
          "minimum": 1,
          "title": "Rank Overall",
          "type": "integer"
        },
        "value_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Score"
        },
        "value_trap_flag": {
          "default": false,
          "title": "Value Trap Flag",
          "type": "boolean"
        }
      },
      "required": [
        "fundamentals",
        "rank_overall"
      ],
      "title": "RankingRowV1",
      "type": "object"
    },
    "RunOptionsV1": {
      "description": "Optionen eines Runs. Sie reisen mit, damit jede Stufe allein entscheiden kann.",
      "properties": {
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "force_refresh": {
          "default": false,
          "title": "Force Refresh",
          "type": "boolean"
        },
        "notify": {
          "default": true,
          "title": "Notify",
          "type": "boolean"
        }
      },
      "title": "RunOptionsV1",
      "type": "object"
    },
    "UniverseInfoV1": {
      "description": "Woher das Universum kam. Der Report zeigt es, ``size`` zaehlt fuer partial/ok.",
      "properties": {
        "added": {
          "items": {
            "$ref": "#/$defs/UniverseMemberV1"
          },
          "title": "Added",
          "type": "array"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "As Of"
        },
        "removed": {
          "items": {
            "$ref": "#/$defs/UniverseMemberV1"
          },
          "title": "Removed",
          "type": "array"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "source",
        "as_of",
        "size"
      ],
      "title": "UniverseInfoV1",
      "type": "object"
    },
    "UniverseMemberV1": {
      "description": "Ein Titel, der in der Indexquelle gegenueber der Fallback-CSV neu ist oder fehlt.",
      "properties": {
        "index": {
          "title": "Index",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "name",
        "index"
      ],
      "title": "UniverseMemberV1",
      "type": "object"
    },
    "ValueMetricsV1": {
      "properties": {

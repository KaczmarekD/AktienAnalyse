{
  "$defs": {
    "FundamentalsV1": {
      "description": "Ein Titel. Fehlende Werte sind ``None``; Fehler des Abrufs stehen in ``errors``.",
      "properties": {
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "growth": {
          "$ref": "#/$defs/GrowthV1",
          "default": {
            "eps_growth_5y": null,
            "revenue_growth_5y": null
          }
        },
        "identity": {
          "$ref": "#/$defs/IdentityV1"
        },
        "market": {
          "$ref": "#/$defs/MarketDataV1",
          "default": {
            "enterprise_value": null,
            "market_cap": null,
            "price": null,
            "shares_outstanding": null
          }
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceV1",
          "default": {
            "fetched_at": null,
            "fiscal_period_end": null,
            "statement_fx": null
          }
        },
        "quality": {
          "$ref": "#/$defs/QualityMetricsV1",
          "default": {
            "debt_to_equity": null,
            "earnings_stability": null,
            "fcf_margin": null,
            "gross_margin": null,
            "net_debt_ebitda": null,
            "operating_margin": null,
            "roa": null,
            "roic": null
          }
        },
        "value": {
          "$ref": "#/$defs/ValueMetricsV1",
          "default": {
            "buyback_yield": null,
            "dividend_yield": null,
            "ev_ebit": null,
            "p_fcf": null,
            "pb_ratio": null,
            "pe_ratio": null,
            "shareholder_yield": null
          }
        }
      },
      "required": [
        "identity"
      ],
      "title": "FundamentalsV1",
      "type": "object"
    },
    "GrowthV1": {
      "properties": {
        "eps_growth_5y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eps Growth 5Y"
        },
        "revenue_growth_5y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revenue Growth 5Y"
        }
      },
      "title": "GrowthV1",
      "type": "object"
    },
    "IdentityV1": {
      "properties": {
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "financial_currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Financial Currency"
        },
        "index": {
          "title": "Index",
          "type": "string"
        },
        "industry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Industry"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "name",
        "index"
      ],
      "title": "IdentityV1",
      "type": "object"
    },
    "MarketDataV1": {
      "properties": {
        "enterprise_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enterprise Value"
        },
        "market_cap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Cap"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "shares_outstanding": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shares Outstanding"
        }
      },
      "title": "MarketDataV1",
      "type": "object"
    },
    "ProfileRefV1": {
      "description": "Ein Scoring-Profil in einer bestimmten Version (Phase 2b).",
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "profile_id",
        "version"
      ],
      "title": "ProfileRefV1",
      "type": "object"
    },
    "ProvenanceV1": {
      "properties": {
        "fetched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched At"
        },
        "fiscal_period_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fiscal Period End"
        },
        "statement_fx": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement Fx"
        }
      },
      "title": "ProvenanceV1",
      "type": "object"
    },
    "QualityMetricsV1": {
      "properties": {
        "debt_to_equity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Debt To Equity"
        },
        "earnings_stability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earnings Stability"
        },
        "fcf_margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fcf Margin"
        },
        "gross_margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gross Margin"
        },
        "net_debt_ebitda": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Net Debt Ebitda"
        },
        "operating_margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operating Margin"
        },
        "roa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roa"
        },
        "roic": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roic"
        }
      },
      "title": "QualityMetricsV1",
      "type": "object"
    },
    "RankingRowV1": {
      "description": "Fundamentaldaten plus Bewertung. notification rendert Mail und CSV allein daraus.\n\nDie Scores sind Perzentilraenge zwischen 0 und 1, ``None`` ohne genug Faktoren.\n``factor_ranks`` haelt die Raenge je Faktor, Schluessel wie im Scoring-Profil\n(z. B. ``ev_ebit``, ``roic``).",
      "properties": {
        "composite_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Score"
        },
        "factor_ranks": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Factor Ranks",
          "type": "object"
        },
        "fundamentals": {
          "$ref": "#/$defs/FundamentalsV1"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "rank_overall": {
          "minimum": 1,
          "title": "Rank Overall",
          "type": "integer"
        },
        "value_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Score"
        },
        "value_trap_flag": {
          "default": false,
          "title": "Value Trap Flag",
          "type": "boolean"
        }
      },
      "required": [
        "fundamentals",
        "rank_overall"
      ],
      "title": "RankingRowV1",
      "type": "object"
    },
    "ValueMetricsV1": {
      "properties": {
        "buyback_yield": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Buyback Yield"
        },
        "dividend_yield": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dividend Yield"
        },
        "ev_ebit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ev Ebit"
        },
        "p_fcf": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Fcf"
        },
        "pb_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pb Ratio"
        },
        "pe_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pe Ratio"
        },
        "shareholder_yield": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shareholder Yield"
        }
      },
      "title": "ValueMetricsV1",
      "type": "object"
    }
  },
  "description": "scoring -> notification, web-api: das Ranking eines Bewertungslaufs.",
  "properties": {
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileRefV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ranking": {
      "items": {
        "$ref": "#/$defs/RankingRowV1"
      },
      "title": "Ranking",
      "type": "array"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "scoring_run_id": {
      "title": "Scoring Run Id",
      "type": "integer"
    },
    "trigger": {
      "enum": [
        "scheduled",
        "manual",
        "rescore"
      ],
      "title": "Trigger",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "scoring_run_id",
    "trigger"
  ],
  "title": "ScoringRunCompletedV1",
  "type": "object"
}

      "title": "ValueMetricsV1",
      "type": "object"
    }
  },
  "description": "scoring -> notification, web-api: das Ranking eines Bewertungslaufs.\n\nEnthaelt alles, was notification fuer Mail und CSV braucht. Keine bewertbaren Daten\nsind kein leeres Ranking, sondern ``screening.run.failed`` mit ``reason=\"no_data\"``.",
  "properties": {
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "fetch_run_id": {
      "minimum": 1,
      "title": "Fetch Run Id",
      "type": "integer"
    },
    "options": {
      "$ref": "#/$defs/RunOptionsV1"
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileRefV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality_weight": {
      "maximum": 1,
      "minimum": 0,
      "title": "Quality Weight",
      "type": "number"
    },
    "ranking": {
      "items": {
        "$ref": "#/$defs/RankingRowV1"
      },
      "minItems": 1,
      "title": "Ranking",
      "type": "array"
    },
    "run_id": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "scoring_run_id": {
      "minimum": 1,
      "title": "Scoring Run Id",
      "type": "integer"
    },
    "trigger": {
      "enum": [
        "scheduled",
        "manual",
        "rescore"
      ],
      "title": "Trigger",
      "type": "string"
    },
    "universe": {
      "$ref": "#/$defs/UniverseInfoV1"
    },
    "value_weight": {
      "maximum": 1,
      "minimum": 0,
      "title": "Value Weight",
      "type": "number"
    }
  },
  "required": [
    "run_id",
    "trigger",
    "options",
    "scoring_run_id",
    "fetch_run_id",
    "as_of",
    "universe",
    "value_weight",
    "quality_weight",
    "ranking"
  ],
  "title": "ScoringRunCompletedV1",
  "type": "object"
}

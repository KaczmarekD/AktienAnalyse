    },
    "ProfileRefV1": {
      "description": "Ein Scoring-Profil in einer bestimmten Version (Phase 2b).",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "profile_id": {
          "minimum": 1,
          "title": "Profile Id",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "profile_id",
        "version"
      ],
      "title": "ProfileRefV1",
      "type": "object"
    },
    "ProvenanceV1": {
      "properties": {
        "fetched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched At"
        },
        "fiscal_period_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fiscal Period End"
        },
        "statement_fx": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement Fx"

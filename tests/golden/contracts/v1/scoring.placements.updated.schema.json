{
  "$defs": {
    "PlacementV1": {
      "description": "Eine Aktie aus den Depots, eingeordnet ins Referenzuniversum (D4.1, ANA-01 bis 03).\n\nIhre Raenge sind die, die sie haette, wenn man sie allein dem Referenzuniversum hinzufuegte;\ndie Raenge der Referenz aendern sich nicht. ``below_size_filter``: ein Titel des Universums\nunter dem Groessenfilter, sonst einer ausserhalb (Abdeckung). Ohne Composite nennt ``reason``\nden Grund. Ohne Nutzer und Mengen (WP-09).",
      "properties": {
        "below_size_filter": {
          "default": false,
          "title": "Below Size Filter",
          "type": "boolean"
        },
        "composite_percentile": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Percentile"
        },
        "composite_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Score"
        },
        "factor_ranks": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Factor Ranks",
          "type": "object"
        },
        "industry_rule": {
          "default": false,
          "title": "Industry Rule",
          "type": "boolean"
        },
        "instrument_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "isin": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isin"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "no_value",
                "no_quality",
                "no_data"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "value_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Score"
        },
        "value_trap_flag": {
          "default": false,
          "title": "Value Trap Flag",
          "type": "boolean"
        },
        "value_trap_reason": {
          "anyOf": [
            {
              "enum": [
                "quality",
                "momentum"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Trap Reason"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "PlacementV1",
      "type": "object"
    }
  },
  "description": "scoring -> portfolio (D4.6): Aktien, sofort eingeordnet gegen den letzten Bewertungslauf.\n\n``scoring_run_id``: der Bewertungslauf, dessen Referenzuniversum und Profil galten; ``as_of``:\nTag des Abrufs der Kennzahlen. Der naechste Wochenlauf ersetzt die Einordnung.",
  "properties": {
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "placements": {
      "items": {
        "$ref": "#/$defs/PlacementV1"
      },
      "title": "Placements",
      "type": "array"
    },
    "scoring_run_id": {
      "minimum": 1,
      "title": "Scoring Run Id",
      "type": "integer"
    }
  },
  "required": [
    "scoring_run_id",
    "as_of"
  ],
  "title": "PlacementsUpdatedV1",
  "type": "object"
}

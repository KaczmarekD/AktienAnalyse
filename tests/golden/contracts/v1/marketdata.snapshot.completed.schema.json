            "fetched_at": null,
            "fiscal_period_end": null,
            "statement_fx": null
          }
        },
        "quality": {
          "$ref": "#/$defs/QualityMetricsV1",
          "default": {
            "debt_to_equity": null,
            "earnings_stability": null,
            "fcf_margin": null,
            "gross_margin": null,
            "net_debt_ebitda": null,
            "operating_margin": null,
            "roa": null,
            "roic": null
          }
        },
        "value": {
          "$ref": "#/$defs/ValueMetricsV1",

          "default": {
            "eps_growth_5y": null,
            "revenue_growth_5y": null
          }
        },
        "identity": {
          "$ref": "#/$defs/IdentityV1"
        },
        "market": {
          "$ref": "#/$defs/MarketDataV1",
          "default": {
            "enterprise_value": null,
            "market_cap": null,
            "price": null,
            "shares_outstanding": null

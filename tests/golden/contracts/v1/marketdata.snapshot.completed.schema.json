            "buyback_yield": null,
            "dividend_yield": null,
            "ev_ebit": null,
            "p_fcf": null,
            "pb_ratio": null,
            "pe_ratio": null,
            "shareholder_yield": null
          }
        }
      },
      "required": [
        "identity"
      ],
      "title": "FundamentalsV1",
      "type": "object"
    },

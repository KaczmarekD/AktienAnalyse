{
  "$defs": {
    "CashLineV1": {
      "description": "Guthaben auf dem Verrechnungskonto; vorerst nur EUR (DEP-04).",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "const": "EUR",
          "default": "EUR",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "title": "CashLineV1",
      "type": "object"
    },
    "DepotExportV1": {
      "description": "Ein Depot mit allen seinen Depotstaenden, aelteste zuerst (Datenexport, NUT-12, D3.2).",
      "properties": {
        "depot": {
          "$ref": "#/$defs/DepotV1"
        },
        "versions": {
          "items": {
            "$ref": "#/$defs/HoldingsV1"
          },
          "title": "Versions",
          "type": "array"
        }
      },
      "required": [
        "depot"
      ],
      "title": "DepotExportV1",
      "type": "object"
    },
    "DepotV1": {
      "description": "Ein Depot mit dem Stand seines Bestands; ``version`` 0 heisst: noch nichts erfasst.\n\n``valuation`` (D3.4): fehlt, wenn portfolio keine Marktdaten hat oder sie nicht lesbar sind.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "depot",
            "watchlist"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "positions": {
          "minimum": 0,
          "title": "Positions",
          "type": "integer"
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ],
          "title": "Status",
          "type": "string"
        },
        "valuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepotValuationV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "status",
        "created_at",
        "version",
        "positions"
      ],
      "title": "DepotV1",
      "type": "object"
    },
    "DepotValuationV1": {
      "description": "Bewertung eines Depots (D3.4, DEP-07, DEP-13).\n\n``value_eur`` = bewertete Positionen + Kasse; ohne Wert bei einer Beobachtungsliste.\n``complete`` heisst: jede Position mit Menge hat einen Wert; sonst zaehlt ``unvalued`` die\nfehlenden. ``price_date``: der aelteste Kurs der bewerteten Positionen. Einstand und Differenz\nnur ueber Positionen, fuer die sie bekannt sind. ``positions`` nur bei ``depots.get``.",
      "properties": {
        "cash_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cash Eur"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "cost_basis_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Basis Eur"
        },
        "difference_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference Eur"
        },
        "pending": {
          "default": 0,
          "minimum": 0,
          "title": "Pending",
          "type": "integer"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/PositionValueV1"
          },
          "title": "Positions",
          "type": "array"
        },
        "positions_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positions Eur"
        },
        "price_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Date"
        },
        "unvalued": {
          "default": 0,
          "minimum": 0,
          "title": "Unvalued",
          "type": "integer"
        },
        "value_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Eur"
        }
      },
      "title": "DepotValuationV1",
      "type": "object"
    },
    "HoldingLineV1": {
      "description": "Eine Position. In einer Beobachtungsliste ohne Menge und Einstand.",
      "properties": {
        "cost_basis_eur": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Basis Eur"
        },
        "isin": {
          "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
          "title": "Isin",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit": {
          "default": "pieces",
          "enum": [
            "pieces",
            "nominal"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "isin"
      ],
      "title": "HoldingLineV1",
      "type": "object"
    },
    "HoldingsV1": {
      "description": "Ein Depotstand. ``version`` 0 ist der leere Stand vor der ersten Speicherung.",
      "properties": {
        "cash": {
          "items": {
            "$ref": "#/$defs/CashLineV1"
          },
          "title": "Cash",
          "type": "array"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "created_by": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "depot_id": {
          "minimum": 1,
          "title": "Depot Id",
          "type": "integer"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/HoldingLineV1"
          },
          "title": "Lines",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "manual",
                "import",
                "bank"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "depot_id",
        "version"
      ],
      "title": "HoldingsV1",
      "type": "object"
    },
    "PositionScoreV1": {
      "description": "Scores einer Aktie im Depot (D4.2, ANA-01): aus dem juengsten Bewertungslauf, der sie kennt.\n\n``reference``: ``universe`` heisst Titel des Rankings, mit denselben Werten wie dort und dem\nRang (``rank``). Sonst ist sie eingeordnet ins Referenzuniversum (D4.1): als Universumstitel\nunter dem Groessenfilter oder von ausserhalb. Ohne Composite nennt ``reason`` den Grund.\n``as_of``: Stand des Abrufs, auf dem der Bewertungslauf beruht.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "composite_percentile": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Percentile"
        },
        "composite_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Score"
        },
        "industry_rule": {
          "default": false,
          "title": "Industry Rule",
          "type": "boolean"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "no_value",
                "no_quality",
                "no_data"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reference": {
          "enum": [
            "universe",
            "below_size_filter",
            "outside"
          ],
          "title": "Reference",
          "type": "string"
        },
        "scoring_run_id": {
          "minimum": 1,
          "title": "Scoring Run Id",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "value_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Score"
        },
        "value_trap_flag": {
          "default": false,
          "title": "Value Trap Flag",
          "type": "boolean"
        },
        "value_trap_reason": {
          "anyOf": [
            {
              "enum": [
                "quality",
                "momentum"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Trap Reason"
        }
      },
      "required": [
        "scoring_run_id",
        "as_of",
        "symbol",
        "reference"
      ],
      "title": "PositionScoreV1",
      "type": "object"
    },
    "PositionValueV1": {
      "description": "Eine bewertete Position (D3.4, DEP-07): Kurs mit Datum und Quelle, Wert in EUR.\n\n``price`` in ``price_currency`` (Hauptwaehrung), bei ``percent_of_par`` in Prozent vom\nNennwert. ``fx_rate``: 1 Einheit ``price_currency`` in EUR. ``value_eur`` fehlt mit Grund\n(``missing``), nie als 0; in einer Beobachtungsliste fehlt er ohne Grund. ``pending``: noch\nohne Stammdaten (\"wird geprueft\", WP-13).",
      "properties": {
        "asset_class": {
          "anyOf": [
            {
              "enum": [
                "equity",
                "etf",
                "bond",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Class"
        },
        "cost_basis_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Basis Eur"
        },
        "difference_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference Eur"
        },
        "fx_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Rate"
        },
        "isin": {
          "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
          "title": "Isin",
          "type": "string"
        },
        "missing": {
          "anyOf": [
            {
              "enum": [
                "price",
                "fx",
                "unit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "pending": {
          "default": false,
          "title": "Pending",
          "type": "boolean"
        },
        "percent_of_par": {
          "default": false,
          "title": "Percent Of Par",
          "type": "boolean"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "price_currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Currency"
        },
        "price_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Date"
        },
        "price_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Source"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionScoreV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "default": "pieces",
          "enum": [
            "pieces",
            "nominal"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Eur"
        }
      },
      "required": [
        "isin"
      ],
      "title": "PositionValueV1",
      "type": "object"
    },
    "RpcErrorV1": {
      "properties": {
        "code": {
          "enum": [
            "no_data",
            "unknown_profile",
            "unknown_version",
            "conflict",
            "invalid",
            "internal",
            "not_found",
            "archived"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "newest": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Newest"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RpcErrorV1",
      "type": "object"
    }
  },
  "properties": {
    "depots": {
      "items": {
        "$ref": "#/$defs/DepotExportV1"
      },
      "title": "Depots",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RpcErrorV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "DepotExportReplyV1",
  "type": "object"
}

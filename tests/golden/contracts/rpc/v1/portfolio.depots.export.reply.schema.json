{
  "$defs": {
    "CashLineV1": {
      "description": "Guthaben auf dem Verrechnungskonto; vorerst nur EUR (DEP-04).",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "const": "EUR",
          "default": "EUR",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "title": "CashLineV1",
      "type": "object"
    },
    "DepotExportV1": {
      "description": "Ein Depot mit allen seinen Depotstaenden, aelteste zuerst (Datenexport, NUT-12, D3.2).",
      "properties": {
        "acks": {
          "items": {
            "$ref": "#/$defs/HintAckV1"
          },
          "title": "Acks",
          "type": "array"
        },
        "depot": {
          "$ref": "#/$defs/DepotV1"
        },
        "hint_params": {
          "items": {
            "$ref": "#/$defs/HintParamsVersionV1"
          },
          "title": "Hint Params",
          "type": "array"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/TargetVersionV1"
          },
          "title": "Targets",
          "type": "array"
        },
        "versions": {
          "items": {
            "$ref": "#/$defs/HoldingsV1"
          },
          "title": "Versions",
          "type": "array"
        }
      },
      "required": [
        "depot"
      ],
      "title": "DepotExportV1",
      "type": "object"
    },
    "DepotV1": {
      "description": "Ein Depot mit dem Stand seines Bestands; ``version`` 0 heisst: noch nichts erfasst.\n\n``valuation`` (D3.4): fehlt, wenn portfolio keine Marktdaten hat oder sie nicht lesbar sind.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "depot",
            "watchlist"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "positions": {
          "minimum": 0,
          "title": "Positions",
          "type": "integer"
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ],
          "title": "Status",
          "type": "string"
        },
        "valuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/DepotValuationV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "status",
        "created_at",
        "version",
        "positions"
      ],
      "title": "DepotV1",
      "type": "object"
    },
    "DepotValuationV1": {
      "description": "Bewertung eines Depots (D3.4, DEP-07, DEP-13).\n\n``value_eur`` = bewertete Positionen + Kasse; ohne Wert bei einer Beobachtungsliste.\n``complete`` heisst: jede Position mit Menge hat einen Wert; sonst zaehlt ``unvalued`` die\nfehlenden. ``price_date``: der aelteste Kurs der bewerteten Positionen. Einstand und Differenz\nnur ueber Positionen, fuer die sie bekannt sind. ``positions`` nur bei ``depots.get``.",
      "properties": {
        "cash_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cash Eur"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "cost_basis_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Basis Eur"
        },
        "difference_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference Eur"
        },
        "pending": {
          "default": 0,
          "minimum": 0,
          "title": "Pending",
          "type": "integer"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/PositionValueV1"
          },
          "title": "Positions",
          "type": "array"
        },
        "positions_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positions Eur"
        },
        "price_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Date"
        },
        "unvalued": {
          "default": 0,
          "minimum": 0,
          "title": "Unvalued",
          "type": "integer"
        },
        "value_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Eur"
        }
      },
      "title": "DepotValuationV1",
      "type": "object"
    },
    "HintAckV1": {
      "description": "D5.3: ein Hinweis zur Kenntnis genommen, mit Messwert und Schwere in diesem Moment.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "key": {
          "maxLength": 200,
          "title": "Key",
          "type": "string"
        },
        "measured": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "key",
        "severity",
        "at"
      ],
      "title": "HintAckV1",
      "type": "object"
    },
    "HintParamsV1": {
      "description": "Schwellen der Hinweise je Depot (HIN-04), mit Standardwerten aus dem Katalog.\n\nAnteile als Bruchteil (0,1 = 10 %), TER und Kurs in Prozent, Fondsvolumen in Millionen EUR.\n``disabled``: abgeschaltete Regeln. Ein gespeicherter Stand ohne ein spaeter neues Feld bekommt\nbeim Lesen den Standardwert, wie bei den Scoring-Profilen.",
      "properties": {
        "a01_deviation": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "A01 Deviation",
          "type": "number"
        },
        "a02_cash": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "A02 Cash",
          "type": "number"
        },
        "b01_days": {
          "default": 90,
          "maximum": 3650,
          "minimum": 1,
          "title": "B01 Days",
          "type": "integer"
        },
        "b02_price": {
          "default": 80.0,
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "B02 Price",
          "type": "number"
        },
        "b03_maturity_year": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "B03 Maturity Year",
          "type": "number"
        },
        "candidates": {
          "default": false,
          "title": "Candidates",
          "type": "boolean"
        },
        "d01_trading_days": {
          "default": 5,
          "maximum": 60,
          "minimum": 1,
          "title": "D01 Trading Days",
          "type": "integer"
        },
        "d02_bank_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "D02 Bank Days",
          "type": "integer"
        },
        "disabled": {
          "items": {
            "enum": [
              "HIN-K01",
              "HIN-K02",
              "HIN-K03",
              "HIN-K04",
              "HIN-K05",
              "HIN-K06",
              "HIN-A01",
              "HIN-A02",
              "HIN-Q01",
              "HIN-Q02",
              "HIN-Q03",
              "HIN-Q04",
              "HIN-Q05",
              "HIN-Q06",
              "HIN-E01",
              "HIN-E02",
              "HIN-E03",
              "HIN-B01",
              "HIN-B02",
              "HIN-B03",
              "HIN-N01",
              "HIN-N02",
              "HIN-D01",
              "HIN-D02",
              "HIN-D03"
            ],
            "type": "string"
          },
          "title": "Disabled",
          "type": "array"
        },
        "e01_ter": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "E01 Ter",
          "type": "number"
        },
        "e02_overlap": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "E02 Overlap",
          "type": "number"
        },
        "e03_fund_size": {
          "default": 100.0,
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "E03 Fund Size",
          "type": "number"
        },
        "k01_critical": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "K01 Critical",
          "type": "number"
        },
        "k01_warning": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "K01 Warning",
          "type": "number"
        },
        "k02_top5": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "K02 Top5",
          "type": "number"
        },
        "k03_sector": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "K03 Sector",
          "type": "number"
        },
        "k04_country": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "K04 Country",
          "type": "number"
        },
        "k05_foreign_currency": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "K05 Foreign Currency",
          "type": "number"
        },
        "k06_issuer": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "K06 Issuer",
          "type": "number"
        },
        "n01_days": {
          "default": 7,
          "maximum": 90,
          "minimum": 1,
          "title": "N01 Days",
          "type": "integer"
        },
        "n02_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "N02 Days",
          "type": "integer"
        },
        "q02_percentile": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Q02 Percentile",
          "type": "number"
        },
        "q03_drop": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Q03 Drop",
          "type": "number"
        },
        "q04_quality": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Q04 Quality",
          "type": "number"
        }
      },
      "title": "HintParamsV1",
      "type": "object"
    },
    "HintParamsVersionV1": {
      "description": "D5.3: eine gespeicherte Version der Schwellen eines Depots (Datenexport, NUT-12).",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/HintParamsV1"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "params",
        "created_at"
      ],
      "title": "HintParamsVersionV1",
      "type": "object"
    },
    "HoldingLineV1": {
      "description": "Eine Position. In einer Beobachtungsliste ohne Menge und Einstand.",
      "properties": {
        "cost_basis_eur": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Basis Eur"
        },
        "isin": {
          "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
          "title": "Isin",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,21}0*$)\\d{0,12}\\.\\d{0,8}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit": {
          "default": "pieces",
          "enum": [
            "pieces",
            "nominal"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "isin"
      ],
      "title": "HoldingLineV1",
      "type": "object"
    },
    "HoldingsV1": {
      "description": "Ein Depotstand. ``version`` 0 ist der leere Stand vor der ersten Speicherung.",
      "properties": {
        "cash": {
          "items": {
            "$ref": "#/$defs/CashLineV1"
          },
          "title": "Cash",
          "type": "array"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "created_by": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "depot_id": {
          "minimum": 1,
          "title": "Depot Id",
          "type": "integer"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/HoldingLineV1"
          },
          "title": "Lines",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "manual",
                "import",
                "bank"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "depot_id",
        "version"
      ],
      "title": "HoldingsV1",
      "type": "object"
    },
    "PositionScoreV1": {
      "description": "Scores einer Aktie im Depot (D4.2, ANA-01): aus dem juengsten Bewertungslauf, der sie kennt.\n\n``reference``: ``universe`` heisst Titel des Rankings, mit denselben Werten wie dort und dem\nRang (``rank``). Sonst ist sie eingeordnet ins Referenzuniversum (D4.1): als Universumstitel\nunter dem Groessenfilter oder von ausserhalb. Ohne Composite nennt ``reason`` den Grund.\n``as_of``: Stand des Abrufs, auf dem der Bewertungslauf beruht.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "composite_percentile": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Percentile"
        },
        "composite_score": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Composite Score"
        },
        "industry_rule": {
          "default": false,
          "title": "Industry Rule",
          "type": "boolean"
        },
        "quality_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Score"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "no_value",
                "no_quality",
                "no_data"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reference": {
          "enum": [
            "universe",
            "below_size_filter",
            "outside"
          ],
          "title": "Reference",
          "type": "string"
        },
        "scoring_run_id": {
          "minimum": 1,
          "title": "Scoring Run Id",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "value_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Score"
        },
        "value_trap_flag": {
          "default": false,
          "title": "Value Trap Flag",
          "type": "boolean"
        },
        "value_trap_reason": {
          "anyOf": [
            {
              "enum": [
                "quality",
                "momentum"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Trap Reason"
        }
      },
      "required": [
        "scoring_run_id",
        "as_of",
        "symbol",
        "reference"
      ],
      "title": "PositionScoreV1",
      "type": "object"
    },
    "PositionValueV1": {
      "description": "Eine bewertete Position (D3.4, DEP-07): Kurs mit Datum und Quelle, Wert in EUR.\n\n``price`` in ``price_currency`` (Hauptwaehrung), bei ``percent_of_par`` in Prozent vom\nNennwert. ``fx_rate``: 1 Einheit ``price_currency`` in EUR. ``value_eur`` fehlt mit Grund\n(``missing``), nie als 0; in einer Beobachtungsliste fehlt er ohne Grund. ``pending``: noch\nohne Stammdaten (\"wird geprueft\", WP-13).",
      "properties": {
        "asset_class": {
          "anyOf": [
            {
              "enum": [
                "equity",
                "etf",
                "bond",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Class"
        },
        "cost_basis_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Basis Eur"
        },
        "difference_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference Eur"
        },
        "fx_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fx Rate"
        },
        "isin": {
          "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
          "title": "Isin",
          "type": "string"
        },
        "missing": {
          "anyOf": [
            {
              "enum": [
                "price",
                "fx",
                "unit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "pending": {
          "default": false,
          "title": "Pending",
          "type": "boolean"
        },
        "percent_of_par": {
          "default": false,
          "title": "Percent Of Par",
          "type": "boolean"

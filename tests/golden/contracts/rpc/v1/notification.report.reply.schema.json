          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "html": {
          "title": "Html",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "scoring_run_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scoring Run Id"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "id",
        "run_id",
        "scoring_run_id",
        "subject",
        "generated_at",
        "csv_filename",
        "html"

{
  "$defs": {
    "DepotV1": {
      "description": "Ein Depot mit dem Stand seines Bestands; ``version`` 0 heisst: noch nichts erfasst.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "depot",
            "watchlist"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "positions": {
          "minimum": 0,
          "title": "Positions",
          "type": "integer"
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "status",
        "created_at",
        "version",
        "positions"
      ],
      "title": "DepotV1",
      "type": "object"
    },
    "RpcErrorV1": {
      "properties": {
        "code": {
          "enum": [
            "no_data",
            "unknown_profile",
            "unknown_version",
            "conflict",
            "invalid",
            "internal",
            "not_found",
            "archived"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "newest": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Newest"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RpcErrorV1",
      "type": "object"
    }
  },
  "properties": {
    "depots": {
      "items": {
        "$ref": "#/$defs/DepotV1"
      },
      "title": "Depots",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RpcErrorV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "DepotListReplyV1",
  "type": "object"
}

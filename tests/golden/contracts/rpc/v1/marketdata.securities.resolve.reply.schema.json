    "EtfV1": {
      "description": "Stand eines Fonds bei einer Quelle (D2.4, WP-10): Fondsdaten, Gewichte und die groessten\nPositionen. Die ganze Liste bleibt in ``market_data.etf_composition``.\n\n``complete``: alle Positionen (Anbieterdatei, z. B. iShares) oder nur die groessten\n(yfinance, dann ohne Laender). Gewichte je Bezeichnung in Prozent, ohne Angabe ``-``.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "asset_classes": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Asset Classes",
          "type": "object"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "countries": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Countries",
          "type": "object"
        },
        "distribution": {
          "anyOf": [
            {
              "enum": [
                "accumulating",
                "distributing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution"
        },
        "effective_duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Duration"
        },
        "fund_currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fund Currency"
        },
        "fund_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fund Size"
        },
        "holdings_count": {
          "minimum": 0,
          "title": "Holdings Count",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "sectors": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Sectors",
          "type": "object"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "ter": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ter"
        },
        "top_holdings": {
          "items": {
            "$ref": "#/$defs/EtfHoldingV1"
          },
          "title": "Top Holdings",
          "type": "array"

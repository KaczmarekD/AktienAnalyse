.env
# data/-Ordner enthält Cache + Fallback-CSV.
# Nur Caches (Parquet) ignorieren, die CSV muss eingecheckt sein.
data/*.parquet
data/value_ranking_*.csv
data/preview_latest.html
data/preview_value_ranking_*.csv
data/cache/
logs/
# PostgreSQL-Daten und Dumps (Bind-Mounts auf der Synology)
pgdata/
backups/
__pycache__/
*.pyc
*.log
.DS_Store

# Coverage
.coverage
.coverage.*
htmlcov/

# Test- und Linter-Caches
.pytest_cache/
.ruff_cache/
pytest-cache-files-*/

# IDE
.vscode/
.idea/
.claude/

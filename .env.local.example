# Lokale Entwicklung (U1, docs/architecture/umgebungen.md). Auf dem Entwicklungsrechner:
#   cp .env.local.example .env
# Die NAS nutzt .env.example.
#
# make local-* (Container): SMTP zeigt fest auf Mailpit, HEALTHCHECK_URL ist leer - egal,
# was hier steht. make run/dry (aus der .venv) lesen diese Datei direkt, deshalb stehen
# auch hier nur lokale Ziele.

# === Mail: an Mailpit, Postfach unter http://localhost:8025 ===
# Pflichtfelder der Settings, lokal nur Platzhalter (SMTP_PLAIN sendet kein Passwort)
SMTP_USER=lokal@example.com
SMTP_PASSWORD=lokal
MAIL_TO=du@example.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_PLAIN=true

# === Universum & Reporting ===
UNIVERSE=DAX_MDAX
TOP_N=20
BOTTOM_N=10
MIN_MARKET_CAP=300000000

# === Lokale Datenbank (Container db, Daten in ./.local/pgdata) ===
# Passwoerter nur aus Buchstaben/Ziffern. Sie wirken beim ersten Start (leeres .local/pgdata).
POSTGRES_PASSWORD=lokalowner
VA_APP_PASSWORD=lokalapp
VA_READ_PASSWORD=lokalread
VA_PROFILES_PASSWORD=lokalprofiles
# Fuer make run/dry aus der .venv (im Container setzt Compose die Adresse selbst).
# 127.0.0.1 statt localhost: Windows versucht bei localhost zuerst IPv6, die Ports lauschen
# aber nur auf IPv4 - jede Verbindung wartete dann, bis der Versuch abbricht.
DATABASE_URL=postgresql+psycopg://va_app:lokalapp@127.0.0.1:5432/value_analyzer
DATABASE_OWNER_URL=postgresql+psycopg://va_owner:lokalowner@127.0.0.1:5432/value_analyzer
DATA_DIR=./data
LOGS_DIR=./.local/logs
# web-api aus der .venv (make api): lesen mit va_read, Profile speichern mit va_profiles
WEB_API_DATABASE_URL=postgresql+psycopg://va_read:lokalread@127.0.0.1:5432/value_analyzer
WEB_API_PROFILES_DATABASE_URL=postgresql+psycopg://va_profiles:lokalprofiles@127.0.0.1:5432/value_analyzer
# Falls Port 5432 schon belegt ist (z. B. ein anderer Postgres): anderen Port waehlen und
# DATABASE_URL, DATABASE_OWNER_URL und die beiden WEB_API_*_DATABASE_URL anpassen
# LOCAL_DB_PORT=5433

TZ=Europe/Berlin

# === Event-Bus (P4.3) ===
# Zum Ausprobieren ueber NATS (Container nats, make local-up): EVENT_BUS=nats.
# Im Container setzt Compose NATS_URL selbst, fuer make run/dry aus der .venv:
# EVENT_BUS=nats
# NATS_URL=nats://127.0.0.1:4222
